extends SceneTree
const Game = preload("res://scripts/auction_game.gd")
const UI = preload("res://scripts/auction_ui.gd")
func _init() -> void: call_deferred("run")
func run() -> void:
	var game := Game.new()
	root.add_child(game)
	game.set_process(false)
	game.reset_cards()
	game.start_lot()
	game.active_player_ids = [1]
	game.cash[1] = 140
	var ui := UI.new()
	root.add_child(ui)
	ui.setup(game)
	ui.market_requested.connect(func(card_id: String) -> void:
		if card_id == "pack": game.buy_market_pack(1)
		else: game.buy_market_card(1,card_id))
	ui.set_market_access(true)
	ui.open_market()
	assert(not ui.market_buy.disabled)
	assert(ui.market_products[0].disabled)
	assert(ui.market_products[0].get_node("Picture").card.is_empty())
	ui.market_buy.pressed.emit()
	assert(game.cash[1] == 70 and game.market_offers[1].size() == 3)
	assert(ui.market_buy.disabled)
	ui.market_products[0].pressed.emit()
	assert(ui.market_selection == -1)
	ui.buy_selected_market_card()
	assert(game.cash[1] == 70 and game.reserves[1].is_empty())
	ui._process(0.3)
	ui.render_state(game.state())
	assert(is_equal_approx(ui.market_reveal_elapsed,0.3))
	assert(ui.market_products[0].get_node("Picture").visible)
	assert(ui.market_products[1].get_node("Back").visible)
	ui._process(0.5)
	ui.market_products[0].pressed.emit()
	assert(not ui.market_buy.disabled)
	assert(ui.market_description.text == str(game.card_definition(game.market_offers[1][0]).text))
	ui.set_market_access(false)
	ui.set_market_access(true)
	ui.open_market()
	assert(game.cash[1] == 70 and game.market_offers[1].size() == 3)
	ui.market_buy.pressed.emit()
	assert(game.cash[1] == 70 and game.reserves[1].size() == 1)
	assert(game.market_offers[1].is_empty())
	ui.market_buy.pressed.emit()
	assert(game.cash[1] == 0 and game.market_offers[1].size() == 3)
	ui._process(1.0)
	ui.market_products[1].pressed.emit()
	assert(not ui.market_buy.disabled)
	ui.market_buy.pressed.emit()
	assert(game.cash[1] == 0 and game.reserves[1].size() == 2)
	assert(ui.market_buy.disabled and ui.market_products[0].disabled)
	ui.buy_selected_market_card()
	assert(game.reserves[1].size() == 2)
	ui.queue_free()
	game.queue_free()
	await process_frame
	print("Market touch selection, description, explicit purchase, refresh and affordability: PASS")
	quit()
