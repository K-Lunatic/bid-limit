extends SceneTree

const NetworkScript = preload("res://scripts/network_session_2d.gd")

func _init() -> void:
	call_deferred("run_smoke")

func run_smoke() -> void:
	var session: Node = NetworkScript.new()
	root.add_child(session)
	var result: Error = session.call("create_host")
	if result != OK:
		print("2D network smoke test: SKIP (WebRTC unavailable: %s)" % result)
		quit()
		return
	assert(session.get("local_peer_id") == 1)
	assert(session.get("players").size() == 1)
	assert(not session.get("room_has_started"))
	session.call("add_bots")
	assert(session.get("players").size() == 4)
	session.call("add_bots")
	assert(session.get("players").size() == 4)
	var sanitized: Dictionary = session.clean_profile({"nickname": "  테스트인형  ", "weapon": 99, "sock": "invalid"})
	assert(sanitized.nickname == "테스트인형" and sanitized.weapon == 2 and sanitized.sock == "e15a67")
	assert(session.call("is_valid_auction_action", "submit:0,1"))
	assert(not session.call("is_valid_auction_action", "submit:"))
	assert(not session.call("is_valid_auction_action", "x".repeat(65)))
	session.call("set_local_profile", {"nickname": "검증인", "weapon": 1})
	assert(session.get("players")[1]["profile"].nickname == "검증인" and session.get("players")[1]["profile"].weapon == 1)
	var public_state: Dictionary = session.call("make_public_auction_state", {"lot": {"value": 999, "hints": ["비밀"], "options": [{"level": 5}]}, "hands": {2: [{"id": "bid"}]}, "energies": {2: 1}, "private_hints_by_player": {2: ["비밀"]}, "inventories": {2: [{"name": "비밀 물품"}]}, "hand": [{"id": "bid"}], "energy": 1, "private_hints": ["비밀"]})
	assert(not public_state.has("hands") and not public_state.has("energies") and not public_state.has("private_hints_by_player"))
	assert(not public_state.lot.has("value") and not public_state.lot.has("hints") and not public_state.lot.has("options"))
	assert(public_state.hand.is_empty() and int(public_state.energy) == 0 and public_state.private_hints.is_empty())
	session.call("receive_signal_candidate", 2, "data", 0, "candidate:test")
	assert(session.get("pending_candidates")[2].size() == 1)
	session.call("handle_disconnect", 2)
	assert(not session.get("pending_candidates").has(2))
	session.call("set_local_input", Vector2.RIGHT)
	var before: Vector2 = session.get("players")[1]["position"]
	session.call("host_step", 0.1)
	assert(session.get("players")[1]["position"].x > before.x)
	session.call("set_local_input", Vector2.LEFT)
	session.call("host_step", 0.1)
	assert(session.call("serialize_snapshot")["players"]["1"]["facing"] == -1)
	var integrity_snapshot: Dictionary = session.call("serialize_snapshot")
	assert(integrity_snapshot.has("suspicious") and integrity_snapshot.has("kick_votes"))
	session.set("local_peer_id", 2)
	session.call("_validate_public_auction_state", {"cash": {"1": -1}})
	assert(session.get("local_suspicious_players").has(1))
	session.set("local_peer_id", 1)
	session.call("_record_integrity_report", 1, 100, "smoke")
	assert(session.get("suspicious_players").has(100))
	session.get("players")[2] = session.call("initial_state", Vector2(1400, 520))
	assert(session.call("_kick_threshold") == 1)
	session.get("players").erase(2)
	var received: Array = []
	session.chat_received.connect(func(sender: int, message: String) -> void: received.append([sender, message]))
	session.call("send_chat", "  안녕\n경매!  ")
	assert(received == [[1, "안녕 경매!"]])
	session.call("send_chat", "너무 빠른 메시지")
	assert(received.size() == 1)
	session.call("start_jump", 1)
	session.call("host_step", 0.35)
	assert(session.get("players")[1]["position"].y < 520.0)
	assert(session.call("serialize_snapshot")["players"]["1"]["p"][1] < 520.0)
	session.call("host_step", 0.36)
	assert(session.get("players")[1]["position"].y == 520.0)
	var bot_before: Vector2 = session.get("players")[100]["position"]
	for tick in 120:
		session.call("host_step", 1.0 / 60.0)
	assert(session.get("players")[100]["position"] == bot_before)
	assert(session.call("seat_at_world_position", Vector2(1195, 526)) == 0)
	assert(session.call("claim_seat", 1, 0))
	assert(not session.call("claim_seat", 100, 0))
	session.call("host_step", 0.1)
	assert(session.get("players")[1]["seat"] == 0 and session.get("players")[1]["ready"])
	session.get("players")[100]["position"] = session.get("players")[1]["position"]
	session.set("auction_active", true)
	session.call("resolve_attack", 1)
	assert(session.get("players")[100]["hp"] == 3)
	session.set("auction_active", false)
	var jammed: Array = []
	session.card_jam_requested.connect(func(id: int) -> void: jammed.append(id))
	session.call("resolve_attack", 1)
	assert(session.get("players")[100]["hp"] == 3 and jammed.is_empty())
	session.call("arm_shield", 100)
	session.get("attack_cooldowns")[1] = 0.0
	session.call("resolve_attack", 1)
	assert(jammed.is_empty())
	print("2D network smoke test: PASS")
	quit()
