extends SceneTree

const CardFan = preload("res://scripts/card_fan_ui.gd")
const AuctionGame = preload("res://scripts/auction_game.gd")

func _init() -> void:
	var fan := CardFan.new()
	assert(fan.card_region("attack", 0) == fan.card_region("attack", 1))
	assert(fan.card_region("attack", 1) == fan.card_region("attack", 2))
	var game := AuctionGame.new()
	for id in ["bid", "draw", "inspect", "publish", "shield", "rumor", "raise", "steal"]:
		var card: Dictionary = game.card_definition(id)
		assert(not str(card.get("name", "")).is_empty())
		assert(not str(card.get("text", "")).is_empty())
		assert(card.has("cost") and int(card.cost) >= 0)
		assert(fan.ART_INDEX.has(id))
	game.free()
	fan.set_cards([{"id": "inspect", "cost": 1}, {"id": "shield", "cost": 1}], [])
	assert(fan._has_point(Vector2(145, 159)))
	assert(fan._has_point(Vector2(175, 159)))
	assert(not fan._has_point(Vector2(15, 20)))
	assert(not fan._has_point(Vector2(300, 150)))
	var dropped: Array = []
	fan.card_dropped.connect(func(index: int) -> void: dropped.append(index))
	fan._begin_drag(Vector2(145, 159))
	assert(fan.preview_index == 0)
	assert(not fan.dragging)
	var enlarged_top := fan._card_transform(0,2).origin - Vector2(0,29)
	assert(fan._card_at(enlarged_top) == 0)
	assert(fan._has_point(Vector2(5,5)))
	fan._move_drag(Vector2(146,159))
	assert(not fan.dragging)
	fan._move_drag(Vector2(145,140))
	assert(fan.dragging)
	fan._end_drag(Vector2(10, 10))
	assert(dropped.is_empty())
	assert(fan.preview_index == 0)
	fan._begin_drag(Vector2(145, 159))
	fan._end_drag(Vector2(160, 90))
	assert(dropped == [0])
	assert(fan.preview_index == -1)
	fan.free()
	print("Card fan hit testing: PASS")
	quit()
