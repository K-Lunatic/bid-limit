extends SceneTree
const Game = preload("res://scripts/auction_game.gd")
func _init() -> void: call_deferred("run")
func run() -> void:
	var game := Game.new()
	root.add_child(game)
	game.set_process(false)
	assert(game.phase == "waiting" and game.timer == 60)
	game._process(20)
	assert(game.timer == 40 and not game.auction_started)
	assert(game.buy_market_pack(1) and game.cash[1] == 430)
	assert(game.change_deck_card(1,"inspect",false))
	game._process(45)
	assert(game.timer == 0 and game.phase == "waiting")
	game.set_table_status(true,4,4)
	assert(game.phase == "auction" and game.timer == Game.TURN_TIME_LIMIT)
	game.set_table_status(false,3,4)
	game.close_auction()
	assert(game.phase == "appraisal" and game.timer == 45)
	game.set_table_status(true,4,4)
	assert(game.phase == "auction" and game.cycle == 2)
	game.queue_free()
	await process_frame
	print("60-second first preparation, explore/edit, wait for seats and 45-second intermission: PASS")
	quit()
