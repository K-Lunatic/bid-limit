extends SceneTree

const AuctionGameScript = preload("res://scripts/auction_game.gd")

func _init() -> void:
	call_deferred("run_smoke")

func run_smoke() -> void:
	var game: Node = AuctionGameScript.new()
	root.add_child(game)
	assert(game.call("state")["hints"].size() == 1)
	assert(game.call("state")["lot"]["option_count"] == 5)
	var estimate: float = game.call("bot_estimate", 100)
	var initial_value: int = game.get("lot")["value"]
	game.get("lot")["value"] = initial_value + 10000
	assert(game.call("bot_estimate", 100) == estimate)
	game.get("lot")["value"] = initial_value
	var initial_state: Dictionary = game.call("state")
	assert(initial_state["goal_rounds"] == 5 and initial_state["goal"].contains("순자산"))
	assert(initial_state["value_range"].size() == 2 and initial_state["value_range"][0] <= initial_state["value_range"][1])
	assert(initial_state["hands"].size() == 4)
	assert(initial_state["hand_counts"]["1"] == 4)
	assert(game.get("decks")[1].size() + game.get("hands")[1].size() + game.get("discards")[1].size() == 12)
	assert(game.get("DEFAULT_DECK_IDS").has("rumor") and game.get("DEFAULT_DECK_IDS").has("raise") and game.get("DEFAULT_DECK_IDS").has("luck"))
	assert(initial_state["private_hints"].size() == 1)
	assert(initial_state["private_hints_by_player"][1] != initial_state["private_hints_by_player"][100])
	game.call("set_table_status", true, 4, 4)
	game.set("active_bot_ids", [])
	game.call("make_bot_bid")
	assert(game.call("state")["leader"] == -1)
	for player_id in [1, 100, 101, 102]:
		assert(game.call("pass_turn", player_id))
	game.call("_process", 2.0)
	assert(game.call("state")["phase"] == "appraisal")
	assert(game.call("state")["announcement"].contains("유찰"))
	game.call("_process", 46.0)
	assert(game.call("state")["phase"] == "auction")
	game.get("hands")[1][0] = game.call("card_definition", "bid")
	game.call("buy_hint")
	assert(game.call("state")["hints"].size() == 2)
	assert(game.call("state")["private_hints"].size() == 2)
	assert(game.call("state")["private_hints_by_player"][100].size() == 1)
	assert(game.get("turn_id") == 100)
	game.call("pass_turn", 100)
	game.call("pass_turn", 101)
	game.call("pass_turn", 102)
	assert(game.get("turn_id") == 1)
	game.call("request_bid")
	assert(game.call("state")["bid"] == 20)
	assert(not game.call("fold_player", 1))
	assert(game.call("fold_player", 100))
	assert(not game.call("place_bid", 100))
	var private_before_inspect: int = game.call("state")["private_hints"].size()
	game.call("_apply_card_effect", {"id": "inspect"}, 1)
	assert(game.call("state")["hints"].size() == 2)
	assert(game.call("state")["private_hints"].size() == private_before_inspect + 1)
	game.call("submit_hand", [0], 1)
	assert(game.call("state")["hand_counts"]["1"] == 4)
	assert(game.call("state")["hand_counts"]["100"] == 5)
	var cash_before_close: int = game.get("cash")[1]
	game.call("close_auction")
	assert(game.call("state")["phase"] == "appraisal")
	assert(game.get("cash")[1] == cash_before_close - 20)
	assert(game.call("state")["inventory"].size() == 1)
	var appraisal: int = game.call("state")["inventory"][0]["appraisal"]
	assert(game.call("sell_item", 1, 0))
	assert(game.get("cash")[1] == cash_before_close - 20 + appraisal)
	assert(not game.call("sell_item", 1, 0))
	game.call("start_lot")
	assert(game.call("state")["phase"] == "auction")
	assert(game.call("state")["folded"].is_empty())
	game.get("inventories")[1] = [{"appraisal": 123}]
	game.get("cash")[1] = 10
	assert(game.call("score_for", 1) == 133)
	var client: Node = AuctionGameScript.new()
	client.set("authoritative", false)
	root.add_child(client)
	client.call("apply_remote_state", {"lot": {"name": "유리병"}, "hints": ["상태: 2/5"], "hand": [], "hand_counts": {"1": 3, "2": 4}})
	assert(client.call("state")["hints"] == ["상태: 2/5"])
	assert(client.call("state")["hand_counts"]["2"] == 4)
	game.set("cycle", 5)
	game.call("close_auction")
	game.call("_process", 46.0)
	assert(game.call("state")["phase"] == "finished")
	assert(game.get("final_scores")[1] == 133)
	assert(game.call("bidder_name", 2) == "PLAYER-2")
	assert(game.call("bidder_name", 100) == "보풀왕 (AI)")
	game.call("set_table_status", true, 4, 4)
	assert(game.call("state")["phase"] == "finished")
	print("Auction loop smoke test: PASS")
	quit()
